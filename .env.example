# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# BAZAARLINK_API_KEY: Optional custom key for BazaarLink Free LLM API (bazaarlink.ai).
# If not provided, an agent key is automatically registered programmatically.
BAZAARLINK_API_KEY=""

# OPENAI_API_KEY: Optional custom key for OpenAI ChatGPT models (gpt-4o, gpt-4o-mini).
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Optional custom key for Claude models (claude-3-5-sonnet).
# If omitted, free high-capability Claude synthesis pipeline is used.
ANTHROPIC_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
